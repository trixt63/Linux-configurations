# speedtest
alias sp='speedtest'

# qtil
alias logout='qtile cmd-obj -o cmd -f shutdown'

# python3 venv
alias activate='source venv/bin/activate.fish'
alias activate_h='source .venv/bin/activate'

# git cli
alias gitlog='git log --all --graph --oneline'

# github key
alias ghp='cat $HOME/Documents/.github-keys'

# cloudflare warp
alias conwarp='warp-cli connect'
alias disconwarp='warp-cli disconnect'

# xfce power manager
alias dont-turn-off='xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/inactivity-on-ac -s 0'

