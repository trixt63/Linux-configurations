<action>
	<icon>preferences-system-user-sudo</icon>
	<name>Open Thunar as Root</name>
	<submenu></submenu>
	<unique-id>1793118657309644-1</unique-id>
	<command>sh -c &apos;pkexec env DISPLAY=&quot;$DISPLAY&quot; XAUTHORITY=&quot;$XAUTHORITY&quot; dbus-run-session thunar &quot;$0&quot;&apos; %f</command>
	<description></description>
	<range>*</range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
</actions>
